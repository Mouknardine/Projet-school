{
  "name": "tradebot-tip",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de trading algorithmique (paper trading) sur données de marché réelles, avec dashboard web.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --disable-warning=ExperimentalWarning --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "~4.1.18",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "lightweight-charts": "^5.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0",
    "tailwindcss": "~4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
