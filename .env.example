# Copiez ce fichier en « .env » pour modifier la configuration.

# Port du serveur web
PORT=3001

# Fréquence d'analyse du marché par les bots (en secondes, minimum 15)
TICK_SECONDS=60

# Mot de passe demandé pour créer / modifier / supprimer un bot.
# Laissez vide en local ; définissez-le absolument si l'application est en ligne.
ADMIN_PASSWORD=

# Emplacement de la base de données SQLite
DB_PATH=data/tradebot.db
